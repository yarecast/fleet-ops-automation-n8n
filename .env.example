# Plantilla sin valores reales. Copiar a .env y generar los secretos localmente.
POSTGRES_ADMIN_USER=admin_super
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

FLEETOPS_DB_NAME=fleetops
FLEETOPS_APP_USER=fleetops_app
FLEETOPS_APP_PASSWORD=CHANGE_ME
FLEETOPS_RO_USER=fleetops_readonly
FLEETOPS_RO_PASSWORD=CHANGE_ME

SAMSARA_MOCK_SHARED_SECRET=CHANGE_ME
NODE_FUNCTION_ALLOW_BUILTIN=crypto

N8N_BLOCK_ENV_ACCESS_IN_NODE=false

SAMSARA_MOCK_INGESTION_URL=http://n8n:5678/webhook/ops/inbound-events

TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
ETA_DEVIATION_ALERT_THRESHOLD_MIN=30