      "parameters": {
        "query": "WITH q AS (\n  UPDATE ops.review_queue SET details = details - 'question'\n  WHERE details->>'question' IS NOT NULL AND (status <> 'pending' OR created_at < now() - interval '14 days')\n  RETURNING 1\n), l AS (\n  DELETE FROM ops.logs WHERE logged_at < now() - interval '90 days' RETURNING 1\n), ins AS (\n  INSERT INTO ops.logs (level, workflow, event_code, execution_id, is_synthetic)\n  VALUES ('info', 'ops-data-retention', 'retention_completed', $1, true) RETURNING 1\n)\nSELECT (SELECT count(*) FROM q) AS question_cleared, (SELECT count(*) FROM l) AS logs_deleted;",
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [String($execution.id)] }}"
        }
      },
      "retryOnFail": true,
      "executeOnce": true,
      "name": "Run Retention",
      "maxTries": 3,
