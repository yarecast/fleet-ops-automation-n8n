    {
      "id": "geh-0002",
      "name": "Build Alert",
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst esc = s => String(s === undefined || s === null ? 'desconocido' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst wf = (d.workflow && d.workflow.name) || 'desconocido';\nconst node = (d.execution && d.execution.lastNodeExecuted) || 'desconocido';\nconst id = d.execution && d.execution.id !== undefined ? String(d.execution.id) : null;\nreturn [{ json: {\n  workflow: wf,\n  node: node,\n  execution_id: id,\n  text: 'Error en <b>' + esc(wf) + '</b>, nodo <b>' + esc(node) + '</b>, ejecucion <b>' + esc(id) + '</b>'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "position": [
        260,
        0
      ],
      "typeVersion": 2
    },
    {
      "credentials": {
        "postgres": {
          "id": "8xkpcIXbV0kg372k",
          "name": "fleetops_app"
        }
      },
      "id": "geh-0003",
      "type": "n8n-nodes-base.postgres",
      "parameters": {
        "query": "INSERT INTO ops.logs (level, workflow, event_code, execution_id, is_synthetic) VALUES ('error', $1, 'workflow_error', $2, true);",
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [$json.workflow, $json.execution_id] }}"
        }
      },
      "executeOnce": true,
      "name": "Log Error",
      "onError": "continueRegularOutput",
      "position": [
        520,
        -120
      ],
      "typeVersion": 2.7,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "geh-0004",
      "name": "Send Telegram",
      "credentials": {
        "telegramApi": {
          "id": "iMWMXJHcvfQuhZEj",
          "name": "telegram_fleetops"
        }
      },
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        },
        "text": "={{ $json.text }}"
      },
      "type": "n8n-nodes-base.telegram",
      "position": [
        520,
